<mujoco model="klann_leg">
<!--
  Built by measuring pivot-hole / pivot-pin locations directly out of each STL
  (via containment-grid + boundary-loop analysis), then cross-checked against
  the two assembly screenshots. Units below are meters (STL was mm, so
  mesh scale = 0.001 and all body offsets are mm*0.001).

  TOPOLOGY (my reconstruction == please sanity-check against your SolidWorks
  mate list, this is the single biggest source of error):

    ground_link (static, one shared pin F)
      +== crank (driven hinge, placeholder axis/throw == NOT derivable from
      |     the mesh since no crank/motor-disc STL was supplied)
      |     +== bent_link  ==[EQUALITY]==> upper_ternary.apex
      +== upper_ternary (hinge @ F)
      |     +== straight_link
      |           +== lower_ternary (hinge @ straight_link far end)
      |                 +== long_straight_link
      |                 |     +== foot_link (hinge @ long_straight_link far end)
      |                 +== long_bent_link ==[EQUALITY]==> foot_link.hole2
      +== foot_stabiliser_link (hinge @ F) ==[EQUALITY]==> foot_link.hole2

  Three independent loops close via <equality><connect>: the crank-drive loop,
  the foot-leveling loop (ground/foot_stabiliser/lower_ternary/upper_ternary),
  and the foot 4-bar (lower_ternary/long_straight_link/foot_link/long_bent_link).

  ASSUMPTIONS FLAGGED FOR YOU TO VERIFY:
   1. crank body: no mesh was provided for it, so its position/orientation
      relative to ground_link and its throw radius are PLACEHOLDERS (25mm
      offset, 10mm throw). Replace with your real crank dimensions.
   2. Each body's initial orientation is assumed IDENTITY (0 rotation) ==
      i.e. I placed parts using their raw local mesh coordinates. Your actual
      assembled angles will differ; MuJoCo's solver will pull the equality
      constraints together on the first steps, but a wildly wrong starting
      angle can make it settle into the wrong branch. If the simulated pose
      looks folded backwards/inside-out compared to the screenshots, rotate
      the offending body's initial qpos (its hinge angle) by ~180 deg.
   3. long_straight_link showed 3 candidate pivot features in the mesh (1 pin
      + 2 close holes); I merged the 2 close holes into one "near" pivot.
      Double check this is right and not actually 2 separate connections.
   4. foot_link's two holes are only 5.8mm apart; I assumed hole2 is shared
      (stacked) by both long_bent_link and foot_stabiliser_link. If your
      design actually has a third pivot point on the foot, this is wrong.
-->

  <compiler angle="degree" meshdir="meshes/"/>
  <option gravity="0 0 0" timestep="0.002"/>

  <default>
    <geom density="1200" contype="0" conaffinity="0" rgba="0.75 0.75 0.78 1"/>
    <joint type="hinge" axis="0 0 1" damping="0.002"/>
  </default>

  <asset>
    <mesh name="ground_link_m"        file="ground_link.STL"          scale="0.001 0.001 0.001"/>
    <mesh name="upper_ternary_m"      file="upper_ternary.STL"        scale="0.001 0.001 0.001"/>
    <mesh name="lower_ternary_m"      file="lower_ternary.STL"        scale="0.001 0.001 0.001"/>
    <mesh name="bent_link_m"          file="bent_link.STL"            scale="0.001 0.001 0.001"/>
    <mesh name="straight_link_m"      file="straight_link.STL"        scale="0.001 0.001 0.001"/>
    <mesh name="long_straight_link_m" file="long_straight_link.STL"   scale="0.001 0.001 0.001"/>
    <mesh name="long_bent_link_m"     file="long_bent_link.STL"       scale="0.001 0.001 0.001"/>
    <mesh name="foot_stabiliser_m"    file="foot_stabiliser_link.STL" scale="0.001 0.001 0.001"/>
    <mesh name="foot_link_m"          file="foot_link.STL"            scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1" diffuse="1 1 1"/>
    <camera name="side" pos="0 -0.3 0.05" xyaxes="1 0 0 0 0 1"/>

    <!-- ground_link: static frame link. Body origin placed at its pivot F,
         so children hinge at (0,0,0) in this frame. -->
    <body name="ground_link" pos="0 0.0 0.05">
      <geom name="ground_link_g" type="mesh" mesh="ground_link_m" pos="-0.0015 -0.0077 -0.006"/>

      <!-- crank: throw radius is a PLACEHOLDER (see note 1); position is
           solved so the crank loop (bent_link -> upper_ternary.apex) closes
           exactly at this rest pose. -->
      <body name="crank" pos="-0.0297 0.01271 0">
        <joint name="crank_joint" pos="0 0 0"/>
        <geom name="crank_g" type="cylinder" size="0.010 0.0015" rgba="0.9 0.5 0.2 1"/>
        <site name="crank_pin" pos="0.010 0 0" size="0.001" rgba="1 0 0 1"/>

        <body name="bent_link" pos="0.010 0 0">
          <joint name="bent_link_joint" pos="0 0 0"/>
          <geom name="bent_link_g" type="mesh" mesh="bent_link_m" pos="-0.01905 -0.0025 -0.001"/>
          <site name="bent_link_far" pos="0.01970 0.00829 0" size="0.001" rgba="0 1 0 1"/>
        </body>
      </body>

      <!-- upper_ternary: fixed pivot mates ground_link's F -->
      <body name="upper_ternary" pos="0 0 0">
        <joint name="upper_ternary_joint" pos="0 0 0"/>
        <geom name="upper_ternary_g" type="mesh" mesh="upper_ternary_m" pos="-0.0177 -0.0026 -0.0035"/>
        <site name="upper_ternary_apex" pos="0 0.0210 0" size="0.001" rgba="0 1 0 1"/>

        <body name="straight_link" pos="-0.0120 0 0">
          <joint name="straight_link_joint" pos="0 0 0"/>
          <geom name="straight_link_g" type="mesh" mesh="straight_link_m" pos="-0.00245 -0.0025 -0.0015"/>

          <body name="lower_ternary" pos="0.00181 0.02561 0">
            <joint name="lower_ternary_joint" pos="0 0 0"/>
            <geom name="lower_ternary_g" type="mesh" mesh="lower_ternary_m" pos="-0.0165 -0.0022 -0.004"/>

            <body name="long_straight_link" pos="-0.0133 0.0610 0">
              <joint name="long_straight_link_joint" pos="0 0 0"/>
              <geom name="long_straight_link_g" type="mesh" mesh="long_straight_link_m" pos="-0.00595 -0.0034 -0.003"/>

              <body name="foot_link" pos="0.02635 0.00710 0">
                <joint name="foot_link_joint" pos="0 0 0"/>
                <geom name="foot_link_g" type="mesh" mesh="foot_link_m" pos="-0.03386 -0.02789 -0.001"/>
                <site name="foot_hole2" pos="0.00540 0.00222 0" size="0.001" rgba="0 1 0 1"/>
              </body>
            </body>

            <body name="long_bent_link" pos="-0.0003 0.0611 0">
              <site name="long_bent_link_far" pos="0 0 0" size="0.008" rgba="1 0 0 1"/>
              <joint name="long_bent_link_origin" pos="0 0 0" size="0.003"/>
              
              <geom name="long_bent_link_g" type="mesh" mesh="long_bent_link_m" pos="-0.0025 -0.0025 -0.0045"/>
              <site name="long_bent_link_far" pos="0.0050 0.0479 0" size="0.001" rgba="0 1 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- foot_stabiliser_link: also mates ground_link's F -->
      <body name="foot_stabiliser_link" pos="0 0 0">
        <joint name="foot_stabiliser_joint" pos="0 0 0"/>
        <geom name="foot_stabiliser_g" type="mesh" mesh="foot_stabiliser_m" pos="-0.0207 -0.0025 -0.006"/>
        <site name="foot_stabiliser_far" pos="-0.0166 0.0667 0" size="0.001" rgba="0 1 0 1"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="loop_crank"     body1="bent_link"           body2="upper_ternary" anchor="0.01970 0.00829 0"/>
    <connect name="loop_foot4bar"  body1="long_bent_link"       body2="foot_link"     anchor="0.0050 0.0479 0"/>
    <connect name="loop_leveler"   body1="foot_stabiliser_link" body2="foot_link"     anchor="-0.0166 0.0667 0"/>
  </equality>

  <actuator>
    <motor name="crank_motor" joint="crank_joint" gear="1" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
